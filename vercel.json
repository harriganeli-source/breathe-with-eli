{
  "ignoreCommand": "git diff HEAD^ HEAD --quiet -- . ':!data/'",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/breathwork",
      "destination": "/work-with-me#breathwork",
      "permanent": true
    },
    {
      "source": "/coaching",
      "destination": "/work-with-me#coaching",
      "permanent": true
    },
    {
      "source": "/clients",
      "destination": "/about#testimonials",
      "permanent": true
    },
    {
      "source": "/private",
      "destination": "/work-with-me",
      "permanent": true
    },
    {
      "source": "/cart",
      "destination": "/book",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}